    },
    "title_left": {
      "title":    { "x": 0.08, "y": 0.35, "w": 0.84, "h": 0.15, "align": "left" },
      "subtitle": { "x": 0.08, "y": 0.55, "w": 0.60, "h": 0.10, "align": "left" }
    },
    "content": {
      "title": { "x": 0.08, "y": 0.06, "w": 0.84, "h": 0.10, "align": "left" },
      "body":  { "x": 0.08, "y": 0.22, "w": 0.84, "h": 0.70, "align": "left", "bullet": true }
    },
    "two_column": {
      "title": { "x": 0.08, "y": 0.06, "w": 0.84, "h": 0.10, "align": "left" },
