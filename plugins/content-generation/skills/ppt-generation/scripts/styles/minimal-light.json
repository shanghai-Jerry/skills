      "subtitle": { "x": 0.15, "y": 0.56, "w": 0.70, "h": 0.10, "align": "center" }
    },
    "image_text": {
      "title": { "x": 0.08, "y": 0.06, "w": 0.84, "h": 0.10, "align": "left" },
