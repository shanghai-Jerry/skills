{
  "name": "minimal-light",
  "description": "Clean light backgrounds, crisp typography, professional and timeless",
  "best_for": "Consulting, academic, formal reports, enterprise",
  "background": {
    "type": "gradient",
    "colors": ["#f5f5f5", "#e8e8e8"],
    "direction": "vertical",
    "api_prompt": "Minimal light background, soft white (#f5f5f5) to light gray (#e8e8e8), clean and professional, subtle paper texture, no text, no people, no objects, 16:9"
  },
  "text": {
    "title": {
      "size": 44,
      "weight": "bold",
      "color": "#1a1a1a",
      "shadow": false
    },
    "subtitle": {
      "size": 22,
      "weight": "normal",
      "color": "#666666",
      "shadow": false
    },
    "body": {
      "size": 18,
      "weight": "normal",
      "color": "#333333",
      "line_height": 1.7,
      "shadow": false,
      "bullet_color": "#2563eb"
    }
  },
  "card": {
    "enabled": true,
    "bg": [255, 255, 255, 220],
    "border_color": [200, 200, 200, 100],
